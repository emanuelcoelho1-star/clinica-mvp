# Copie este arquivo para .env na pasta backend e substitua o valor por um segredo aleatório forte.
# O backend carrega backend/.env automaticamente ao iniciar.
# Nunca coloque o arquivo .env real no GitHub.
JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_FORTE

# SOMENTE PARA TESTES LOCAIS: permite cadastrar clínicas adicionais.
# Não habilite cadastro público sem controles adicionais em produção.
ALLOW_PUBLIC_SIGNUP=true

# Em produção, informe as origens exatas do frontend separadas por vírgula.
# Exemplo: CORS_ORIGINS=https://app.sua-clinica.com.br
# Em desenvolvimento, se omitido, o backend permite as origens locais comuns do React/Vite.

# Painel administrativo exclusivo (não compartilhe estes valores).
ADMIN_EMAIL=emanuelcoelho1@gmail.com
ADMIN_PASSWORD=DEFINA_UMA_SENHA_FORTE_AQUI
ADMIN_JWT_SECRET=SUBSTITUA_POR_OUTRO_SEGREDO_ALEATORIO_FORTE

# Chave exclusiva para criptografar credenciais de provedores de pagamento no banco.
# Gere uma chave aleatória forte e mantenha-a apenas no backend/.env (nunca no Git).
PAYMENT_CREDENTIALS_KEY=DEFINA_UMA_CHAVE_ALEATORIA_FORTE_COM_PELO_MENOS_32_CARACTERES

# Token secreto usado para validar notificações do webhook do Asaas (mínimo 32 caracteres, sem espaços).
# Gere um valor aleatório forte e cadastre exatamente o mesmo token no webhook do painel Asaas.
ASAAS_WEBHOOK_TOKEN=DEFINA_UM_TOKEN_ALEATORIO_FORTE_COM_PELO_MENOS_32_CARACTERES

# URL pública do frontend usada como retorno do checkout Asaas (produção).
APP_PUBLIC_URL=https://sorrisa.com.br
